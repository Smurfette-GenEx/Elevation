    <!-- About -->
    <string name="about_version">Version %1$s</string>
    <string name="about_body">Abstract Reasoning trains visual pattern recognition, inductive reasoning and logical deduction through 100 original puzzles organised in ten chapters of increasing complexity.</string>
    <string name="about_quality_title">Puzzle quality</string>
    <string name="about_quality_body">Every puzzle is drawn from structured data as vector graphics, and every level is checked automatically by an independent solver: the correct answer must be the only option that a consistent rule can explain. Puzzles with more than one defensible answer are rejected during development. All puzzles are original and are not taken from any psychometric test.</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">The game works fully offline. There is no account, no advertising and no data collection; your progress is stored only on this device.</string>
    <string name="about_formats_title">Question formats</string>
    <string name="about_formats_body">Sequence completion · Missing matrix · Transformation logic · Odd one out · Visual relationship · Multi-rule deduction</string>
