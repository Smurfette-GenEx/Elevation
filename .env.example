# --- Core ---
DATABASE_URL="postgresql://expense:expense@localhost:5432/expense?schema=public"
APP_URL="http://localhost:3000"
# 32+ random bytes, used to sign file URLs. Generate: openssl rand -base64 48
APP_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
# Shared secret for scheduled jobs (escalations, FX import)
CRON_SECRET="change-me-cron-secret"
SESSION_TTL_HOURS=12

# --- Storage: "local" or "s3" ---
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_BUCKET=""
S3_REGION="eu-west-1"
S3_ENDPOINT=""
MAX_UPLOAD_MB=10

# --- OCR: "mock" or "azure" ---
OCR_PROVIDER="mock"
AZURE_DI_ENDPOINT=""
AZURE_DI_KEY=""

# --- Email: "console" or "smtp" ---
EMAIL_DRIVER="console"
SMTP_URL=""
EMAIL_FROM="Expenses <no-reply@example.com>"

# --- FX: "ecb" or "none" ---
FX_PROVIDER="ecb"

# --- Future SSO (Microsoft Entra ID) ---
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
